<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password — CSH Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-body">
  <div class="auth-wrapper">

    <div class="auth-brand">
      <div class="brand-icon">📚</div>
      <h1>CSH Tracker</h1>
    </div>

    <div class="auth-card">
      <h2>Reset your password</h2>
      <p class="auth-subtitle">Enter your email and we'll send a reset link</p>

      <% if (error) { %>
        <div class="alert alert-error"><span>⚠</span> <%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><span>✓</span> <%= success %></div>
      <% } %>

      <% if (!success) { %>
        <form action="/forgot-password" method="POST" novalidate>
          <div class="field">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              value="<%= email %>"
              placeholder="you@example.com"
              required
            >
          </div>
          <button type="submit" class="btn-primary">Send Reset Link</button>
        </form>
      <% } %>

      <p class="auth-switch"><a href="/login">← Back to Sign In</a></p>
    </div>

  </div>
</body>
</html>