<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <h2>CSH</h2>
    <nav>
      <a class="active">Dashboard</a>
      <a href="#assignments">Assignments</a>
      <a href="#progress">Progress</a>
    </nav>
  </aside>

  <main class="main">
    <header class="header">
      <div>
        <h2>Welcome, <%= user.name %></h2>
        <p>Today’s focus: complete your mastery work on time.</p>
      </div>
      <button onclick="window.location.href='/logout'">Logout</button>
    </header>

    <section class="priority">
      <h3>🔥 Priority Task</h3>
      <% if (priorityTask) { %>
      <div class="priority-card">
        <h4><%= priorityTask.title %></h4>
        <p>Due <%= priorityTask.due %></p>
        <form action="/student/assignments/<%= priorityTask.id %>/complete" method="POST">
          <button type="submit">Mark Completed</button>
        </form>
      </div>
      <% } else { %>
      <div class="priority-card">
        <h4>All caught up!</h4>
        <p>No urgent mastery tasks due soon.</p>
      </div>
      <% } %>
    </section>

    <section class="grid" id="assignments">
      <div class="card">
        <h3>Assignments</h3>
        <ul>
          <% assignments.forEach(function(item) { %>
            <li class="<%= item.status === 'missing' ? 'urgent' : item.status === 'soon' ? 'soon' : 'done' %>">
              <strong><%= item.title %></strong> - <%= item.due %>
              <% if (item.status !== 'done') { %>
                <form class="inline-form" action="/student/assignments/<%= item.id %>/complete" method="POST">
                  <button type="submit">Complete</button>
                </form>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>

      <div class="card" id="progress">
        <h3>Progress</h3>
        <div class="progress-bar">
          <div style="width:<%= progressPercent %>%"></div>
        </div>
        <p><%= progressPercent %>% Complete</p>
      </div>

      <div class="card">
        <h3>Consistency</h3>
        <p>🔥 <%= streakDays %> Day Streak</p>
      </div>
    </section>
  </main>
</div>
</body>
</html>
